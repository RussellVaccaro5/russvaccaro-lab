---
import StatusBadge, { type Status } from './StatusBadge.astro';

interface Props {
  title: string;
  description: string;
  href: string;
  status: Status;
  technologies: string[];
}

const { title, description, href, status, technologies } = Astro.props;
---

<article class="experiment-card">
  <div class="experiment-card__topline">
    <StatusBadge status={status} />
    <span aria-hidden="true">↗</span>
  </div>
  <h2><a href={href}>{title}</a></h2>
  <p>{description}</p>
  <ul class="pill-list" aria-label="Technologies used">
    {technologies.map((technology) => <li class="pill">{technology}</li>)}
  </ul>
</article>

<style>
  .experiment-card {
    display: flex;
    min-height: 250px;
    padding: 24px;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
    transition:
      transform 160ms ease,
      border-color 160ms ease;
  }

  .experiment-card:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
  }

  .experiment-card__topline {
    display: flex;
    margin-bottom: 32px;
    align-items: center;
    justify-content: space-between;
    color: var(--muted);
  }

  h2 {
    margin-bottom: 10px;
    font-size: 1.35rem;
  }

  h2 a {
    color: var(--text);
    text-decoration: none;
  }

  p {
    color: var(--muted);
  }

  .pill-list {
    margin-top: auto;
  }
</style>
