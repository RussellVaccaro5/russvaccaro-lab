---
interface Props {
  status: 'Shipped' | 'Prototype' | 'Building';
}

const { status } = Astro.props;
const statusClass = status.toLowerCase();
---

<span class={`experiment-status status-${statusClass}`}>
  <span aria-hidden="true"></span>{status}
</span>

<style>
  .experiment-status {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    width: fit-content;
    padding: 0.27rem 0.52rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    background: color-mix(in srgb, var(--surface) 74%, transparent);
    font-size: 0.64rem;
    font-weight: 720;
  }

  .experiment-status > span {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--badge-color);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--badge-color) 14%, transparent);
  }

  .status-shipped { --badge-color: var(--green); }
  .status-prototype { --badge-color: var(--blue); }
  .status-building { --badge-color: var(--orange); }
</style>
