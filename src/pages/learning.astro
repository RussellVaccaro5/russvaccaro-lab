---
import PageHeader from '../components/PageHeader.astro';
import LabLayout from '../layouts/LabLayout.astro';
import { learningNotes } from '../data/learningNotes';

const categories = [...new Set(learningNotes.map((note) => note.category))].sort();
---

<LabLayout
  title="Technical Learning"
  description="Searchable learning cards across AI, data, cloud, DevOps, cybersecurity, and sales."
>
  <PageHeader
    eyebrow="Learning system"
    title="Technical learning cards"
    description="Concise explanations designed for retrieval practice. Search the concept, then open the card only after you try to answer the prompt."
  />

  <div class="controls">
    <div class="field">
      <label for="note-search">Search</label>
      <input id="note-search" type="search" placeholder="eBPF, identity, economic buyer…" />
    </div>
    <div class="field">
      <label for="note-category">Category</label>
      <select id="note-category">
        <option value="all">All categories</option>
        {categories.map((category) => <option value={category}>{category}</option>)}
      </select>
    </div>
  </div>

  <p id="note-count" class="muted" aria-live="polite">{learningNotes.length} cards</p>

  <div id="note-grid" class="note-grid">
    {
      learningNotes.map((note) => (
        <article
          class="note-card"
          data-search={`${note.term} ${note.category} ${note.prompt} ${note.answer} ${note.connections.join(' ')}`.toLowerCase()}
          data-category={note.category}
        >
          <p class="note-card__category">{note.category}</p>
          <h2>{note.term}</h2>
          <p><strong>Prompt:</strong> {note.prompt}</p>
          <details>
            <summary>Reveal answer</summary>
            <p>{note.answer}</p>
            <ul class="pill-list" aria-label="Connected concepts">
              {note.connections.map((connection) => <li class="pill">{connection}</li>)}
            </ul>
          </details>
        </article>
      ))
    }
  </div>
</LabLayout>

<script>
  const search = document.querySelector<HTMLInputElement>('#note-search');
  const category = document.querySelector<HTMLSelectElement>('#note-category');
  const count = document.querySelector<HTMLElement>('#note-count');
  const cards = [...document.querySelectorAll<HTMLElement>('.note-card')];

  const filterNotes = () => {
    const query = search?.value.trim().toLowerCase() ?? '';
    const selectedCategory = category?.value ?? 'all';
    let visible = 0;

    cards.forEach((card) => {
      const matchesSearch = card.dataset.search?.includes(query) ?? false;
      const matchesCategory = selectedCategory === 'all' || card.dataset.category === selectedCategory;
      const shouldShow = matchesSearch && matchesCategory;
      card.hidden = !shouldShow;
      if (shouldShow) visible += 1;
    });

    if (count) count.textContent = `${visible} ${visible === 1 ? 'card' : 'cards'}`;
  };

  search?.addEventListener('input', filterNotes);
  category?.addEventListener('change', filterNotes);
</script>

<style>
  .controls {
    grid-template-columns: 2fr 1fr;
  }

  .note-grid {
    display: grid;
    margin-top: 18px;
    gap: 16px;
  }

  .note-card {
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .note-card__category {
    margin-bottom: 6px;
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  summary {
    color: var(--accent);
    cursor: pointer;
    font-weight: 750;
  }

  details p {
    margin-top: 14px;
  }

  @media (max-width: 620px) {
    .controls {
      grid-template-columns: 1fr;
    }
  }
</style>
