---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found — Russ Vaccaro Lab" description="The requested lab page could not be found.">
  <section class="not-found shell">
    <p class="eyebrow">404 · Wrong turn</p>
    <h1>This experiment is not on the bench.</h1>
    <p>The page may have moved, or the idea may not exist yet.</p>
    <a class="button" href="/">See current projects</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    min-height: 65vh;
    place-content: center;
    justify-items: start;
    padding-block: 5rem;
  }

  .not-found h1 {
    max-width: 50rem;
    margin: 0.7rem 0 1rem;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .not-found > p:not(.eyebrow) {
    margin: 0 0 1.5rem;
    color: var(--muted);
  }
</style>
