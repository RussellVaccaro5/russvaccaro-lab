---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
---

<BaseLayout
  title="Local Scratchpad — Russ Vaccaro Lab"
  description="A private, auto-saving browser scratchpad with Markdown export."
>
  <div class="page-shell scratchpad-page">
    <PageIntro
      eyebrow="Utility · Experiment 02"
      title="Local scratchpad"
      description="A low-friction place for rough thinking. It auto-saves to this browser and exports clean Markdown when the note earns a permanent home."
    >
      <div class="local-badge">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M7 8h10M7 12h6"></path><path d="m15.5 16 1.5 1.5 3-3"></path></svg>
        <span><strong>Local-first</strong><br />Nothing is uploaded</span>
      </div>
    </PageIntro>

    <div class="scratchpad-workspace">
      <section class="tool-panel editor-panel" aria-label="Scratchpad editor">
        <header class="editor-header">
          <div class="title-field">
            <label class="sr-only" for="note-title">Note title</label>
            <input id="note-title" type="text" value="Untitled scratchpad" autocomplete="off" maxlength="120" />
          </div>
          <div class="save-state" id="save-state" role="status" aria-live="polite">
            <span></span>
            <strong>Saved locally</strong>
            <time id="saved-time"></time>
          </div>
        </header>

        <div class="editor-hint" aria-hidden="true">
          <span>Plain text + Markdown</span>
          <span>Auto-saves while you type</span>
        </div>

        <label class="sr-only" for="scratchpad-editor">Scratchpad note</label>
        <textarea
          id="scratchpad-editor"
          spellcheck="true"
          placeholder="Start with the part you do not want to forget…"
        ></textarea>

        <footer class="editor-footer">
          <div class="note-counts" aria-live="polite">
            <span><strong id="word-count">0</strong> words</span>
            <span><strong id="character-count">0</strong> characters</span>
            <span><strong id="line-count">0</strong> lines</span>
          </div>
          <div class="editor-actions">
            <button class="button-ghost" id="copy-note" type="button">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2"></rect><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path></svg>
              Copy
            </button>
            <button class="button-secondary" id="download-note" type="button">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5"></path><path d="M5 21h14"></path></svg>
              Download .md
            </button>
            <button class="button-ghost clear-button" id="open-clear-dialog" type="button">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6M10 10v6M14 10v6"></path></svg>
              Clear
            </button>
          </div>
        </footer>
      </section>

      <aside class="scratchpad-sidebar">
        <section class="sidebar-section" aria-labelledby="starter-title">
          <p class="field-label">Quick structures</p>
          <h2 id="starter-title">Give the blank page a shape.</h2>
          <div class="template-list">
            <button type="button" data-template="call-notes">
              <span>Call notes</span><small>Signals, questions, next steps</small>
            </button>
            <button type="button" data-template="idea-sketch">
              <span>Idea sketch</span><small>Observation, claim, test</small>
            </button>
            <button type="button" data-template="debrief">
              <span>Quick debrief</span><small>Worked, missed, change</small>
            </button>
          </div>
        </section>

        <div class="privacy-card">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10V7a5 5 0 0 1 10 0v3"></path><rect x="4" y="10" width="16" height="11" rx="2"></rect><path d="M12 14v3"></path></svg>
          <div>
            <strong>Private to this browser</strong>
            <p>Clearing site data or using another device will not carry this note with you. Do not store secrets or credentials here.</p>
          </div>
        </div>

        <p class="shortcut-note"><kbd>⌘</kbd> / <kbd>Ctrl</kbd> + <kbd>S</kbd> downloads the current note.</p>
      </aside>
    </div>
  </div>

  <dialog id="clear-dialog" aria-labelledby="clear-dialog-title">
    <div class="dialog-body">
      <h2 id="clear-dialog-title">Clear this scratchpad?</h2>
      <p>The saved note in this browser will be erased. Download it first if you may want it later.</p>
    </div>
    <div class="dialog-actions">
      <button class="button-secondary" id="cancel-clear" type="button">Keep note</button>
      <button class="danger-button" id="confirm-clear" type="button">Clear scratchpad</button>
    </div>
  </dialog>

  <div class="toast-region" aria-live="polite" aria-atomic="true"></div>
</BaseLayout>

<script>
  const STORAGE_KEY = 'rv-lab-scratchpad-v1';
  const titleInput = document.querySelector<HTMLInputElement>('#note-title')!;
  const editor = document.querySelector<HTMLTextAreaElement>('#scratchpad-editor')!;
  const saveState = document.querySelector<HTMLElement>('#save-state')!;
  const savedTime = document.querySelector<HTMLTimeElement>('#saved-time')!;
  const wordCount = document.querySelector<HTMLElement>('#word-count')!;
  const characterCount = document.querySelector<HTMLElement>('#character-count')!;
  const lineCount = document.querySelector<HTMLElement>('#line-count')!;
  const clearDialog = document.querySelector<HTMLDialogElement>('#clear-dialog')!;
  const toastRegion = document.querySelector<HTMLElement>('.toast-region')!;

  type ScratchpadState = {
    title: string;
    body: string;
    savedAt: string;
  };

  const templates: Record<string, { title: string; body: string }> = {
    'call-notes': {
      title: 'Call notes',
      body: '## Context\n\n\n## Signals and questions\n\n- \n\n## Decisions\n\n- \n\n## Next steps\n\n- [ ] ',
    },
    'idea-sketch': {
      title: 'Idea sketch',
      body: '## Observation\n\n\n## Working claim\n\n\n## What would make this useful?\n\n\n## Smallest test\n\n- [ ] ',
    },
    debrief: {
      title: 'Quick debrief',
      body: '## What worked\n\n- \n\n## What I missed\n\n- \n\n## What I will change next time\n\n- [ ] ',
    },
  };

  let saveTimeout: number | undefined;

  const showToast = (message: string) => {
    const toast = document.createElement('div');
    toast.className = 'toast';
    toast.textContent = message;
    toastRegion.append(toast);
    window.setTimeout(() => toast.remove(), 2200);
  };

  const readState = (): ScratchpadState | null => {
    try {
      const stored = localStorage.getItem(STORAGE_KEY);
      return stored ? JSON.parse(stored) : null;
    } catch {
      return null;
    }
  };

  const updateCounts = () => {
    const body = editor.value;
    wordCount.textContent = String(body.trim() ? body.trim().split(/\s+/).length : 0);
    characterCount.textContent = String(body.length);
    lineCount.textContent = String(body ? body.split(/\r?\n/).length : 0);
  };

  const setSaveStatus = (status: 'saving' | 'saved' | 'error', date?: Date) => {
    saveState.dataset.status = status;
    saveState.querySelector('strong')!.textContent = status === 'saving'
      ? 'Saving…'
      : status === 'error'
        ? 'Could not save'
        : 'Saved locally';
    if (status === 'saved' && date) {
      savedTime.dateTime = date.toISOString();
      savedTime.textContent = `· ${date.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' })}`;
    } else if (status === 'error') {
      savedTime.textContent = '· storage unavailable';
    }
  };

  const save = () => {
    const now = new Date();
    const state: ScratchpadState = {
      title: titleInput.value,
      body: editor.value,
      savedAt: now.toISOString(),
    };
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      setSaveStatus('saved', now);
    } catch {
      setSaveStatus('error');
    }
  };

  const scheduleSave = () => {
    setSaveStatus('saving');
    if (saveTimeout !== undefined) window.clearTimeout(saveTimeout);
    saveTimeout = window.setTimeout(save, 300);
  };

  const markdown = () => {
    const title = titleInput.value.trim();
    const body = editor.value;
    return `${title ? `# ${title}\n\n` : ''}${body}${body.endsWith('\n') ? '' : '\n'}`;
  };

  const filename = () => {
    const slug = titleInput.value
      .trim()
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-|-$/g, '')
      .slice(0, 60);
    return `${slug || 'scratchpad'}.md`;
  };

  const downloadNote = () => {
    const blob = new Blob([markdown()], { type: 'text/markdown;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = filename();
    document.body.append(link);
    link.click();
    link.remove();
    URL.revokeObjectURL(url);
    showToast('Markdown downloaded');
  };

  const restored = readState();
  if (restored) {
    titleInput.value = restored.title || 'Untitled scratchpad';
    editor.value = restored.body || '';
    const restoredDate = new Date(restored.savedAt);
    if (!Number.isNaN(restoredDate.getTime())) setSaveStatus('saved', restoredDate);
  } else {
    setSaveStatus('saved', new Date());
  }
  updateCounts();

  editor.addEventListener('input', () => {
    updateCounts();
    scheduleSave();
  });
  titleInput.addEventListener('input', scheduleSave);

  document.querySelector('#copy-note')?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(markdown());
      showToast('Note copied as Markdown');
    } catch {
      editor.select();
      showToast('Clipboard blocked; note selected instead');
    }
  });

  document.querySelector('#download-note')?.addEventListener('click', downloadNote);

  document.querySelectorAll<HTMLButtonElement>('[data-template]').forEach((button) => {
    button.addEventListener('click', () => {
      const template = templates[button.dataset.template ?? ''];
      if (!template) return;
      const insertion = editor.value.trim()
        ? `\n\n---\n\n${template.body}`
        : template.body;
      const start = editor.selectionStart;
      const end = editor.selectionEnd;
      editor.setRangeText(insertion, start, end, 'end');
      if (!editor.value.slice(0, start).trim() && titleInput.value === 'Untitled scratchpad') {
        titleInput.value = template.title;
      }
      editor.focus();
      updateCounts();
      save();
      showToast(`${template.title} structure inserted`);
    });
  });

  document.querySelector('#open-clear-dialog')?.addEventListener('click', () => clearDialog.showModal());
  document.querySelector('#cancel-clear')?.addEventListener('click', () => clearDialog.close());
  document.querySelector('#confirm-clear')?.addEventListener('click', () => {
    titleInput.value = 'Untitled scratchpad';
    editor.value = '';
    localStorage.removeItem(STORAGE_KEY);
    updateCounts();
    clearDialog.close();
    setSaveStatus('saved', new Date());
    editor.focus();
    showToast('Scratchpad cleared');
  });

  clearDialog.addEventListener('click', (event) => {
    if (event.target === clearDialog) clearDialog.close();
  });

  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 's') {
      event.preventDefault();
      save();
      downloadNote();
    }
  });

  window.addEventListener('pagehide', save);
</script>

<style>
  .local-badge {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-width: 11rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid color-mix(in srgb, var(--orange) 28%, var(--line));
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--orange-soft) 48%, var(--surface));
  }

  .local-badge svg {
    width: 1.55rem;
    flex: 0 0 auto;
    fill: none;
    stroke: var(--orange);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.65;
  }

  .local-badge span {
    color: var(--muted);
    font-size: 0.66rem;
    line-height: 1.3;
  }

  .local-badge strong {
    color: var(--text);
    font-size: 0.73rem;
  }

  .scratchpad-workspace {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 16rem;
    align-items: start;
    gap: 1rem;
  }

  .editor-panel {
    min-height: 43rem;
    overflow: hidden;
  }

  .editor-header {
    display: flex;
    min-height: 4.2rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--line);
  }

  .title-field {
    min-width: 0;
    flex: 1;
  }

  .title-field input {
    width: 100%;
    padding: 0;
    border: 0;
    outline: 0;
    color: var(--text);
    background: transparent;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.28rem;
    font-weight: 500;
    letter-spacing: -0.025em;
  }

  .title-field input:focus-visible {
    border-radius: 0.2rem;
    outline: 3px solid color-mix(in srgb, var(--focus) 72%, transparent);
    outline-offset: 4px;
  }

  .save-state {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.35rem;
    color: var(--faint);
    font-size: 0.65rem;
  }

  .save-state > span {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background: var(--green);
  }

  .save-state strong {
    color: var(--muted);
    font-weight: 680;
  }

  .save-state[data-status='saving'] > span {
    background: var(--orange);
    animation: save-pulse 900ms ease-in-out infinite alternate;
  }

  .save-state[data-status='error'] > span { background: #b44848; }

  @keyframes save-pulse { to { opacity: 0.3; } }

  .editor-hint {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.45rem 1rem;
    border-bottom: 1px solid var(--line);
    color: var(--faint);
    background: var(--bg-elevated);
    font-size: 0.62rem;
    font-weight: 650;
  }

  #scratchpad-editor {
    display: block;
    width: 100%;
    min-height: 34rem;
    resize: vertical;
    padding: clamp(1.15rem, 3vw, 2rem);
    border: 0;
    outline: 0;
    color: var(--text);
    background: var(--surface);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.92rem;
    line-height: 1.75;
    tab-size: 2;
  }

  #scratchpad-editor::placeholder { color: var(--faint); }

  .editor-footer {
    display: flex;
    min-height: 4rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 0.85rem 0.7rem 1rem;
    border-top: 1px solid var(--line);
    background: var(--bg-elevated);
  }

  .note-counts,
  .editor-actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .note-counts span {
    padding-right: 0.55rem;
    border-right: 1px solid var(--line);
    color: var(--faint);
    font-size: 0.63rem;
  }

  .note-counts span:last-child {
    padding-right: 0;
    border: 0;
  }

  .note-counts strong {
    color: var(--muted);
    font-weight: 720;
  }

  .editor-actions .button-ghost,
  .editor-actions .button-secondary {
    min-height: 2.35rem;
    padding-block: 0.45rem;
    font-size: 0.72rem;
  }

  .clear-button:hover { color: #b44848; }

  .scratchpad-sidebar {
    display: grid;
    gap: 1rem;
  }

  .sidebar-section,
  .privacy-card {
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--surface) 77%, transparent);
  }

  .sidebar-section h2 {
    margin: 0.25rem 0 0.9rem;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.12;
  }

  .template-list {
    display: grid;
    gap: 0.45rem;
  }

  .template-list button {
    display: grid;
    gap: 0.05rem;
    width: 100%;
    padding: 0.65rem;
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    color: var(--text);
    background: var(--bg-elevated);
    text-align: left;
    transition: border 150ms ease, transform 150ms ease, background 150ms ease;
  }

  .template-list button:hover {
    border-color: var(--orange);
    background: color-mix(in srgb, var(--orange-soft) 35%, var(--surface));
    transform: translateY(-1px);
  }

  .template-list span {
    font-size: 0.75rem;
    font-weight: 720;
  }

  .template-list small {
    color: var(--muted);
    font-size: 0.62rem;
  }

  .privacy-card {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    border-color: color-mix(in srgb, var(--orange) 25%, var(--line));
    background: color-mix(in srgb, var(--orange-soft) 34%, var(--surface));
  }

  .privacy-card svg {
    width: 1.15rem;
    flex: 0 0 auto;
    margin-top: 0.1rem;
    fill: none;
    stroke: var(--orange);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .privacy-card strong {
    font-size: 0.72rem;
  }

  .privacy-card p {
    margin: 0.2rem 0 0;
    color: var(--muted);
    font-size: 0.65rem;
    line-height: 1.45;
  }

  .shortcut-note {
    margin: 0;
    color: var(--faint);
    font-size: 0.63rem;
    text-align: center;
  }

  kbd {
    padding: 0.1rem 0.28rem;
    border: 1px solid var(--line);
    border-bottom-color: var(--line-strong);
    border-radius: 0.25rem;
    color: var(--muted);
    background: var(--surface);
    font-family: inherit;
    font-size: 0.58rem;
    box-shadow: 0 1px 0 var(--line);
  }

  @media (max-width: 900px) {
    .scratchpad-workspace { grid-template-columns: 1fr; }
    .scratchpad-sidebar { grid-template-columns: 1fr 1fr; }
    .shortcut-note { grid-column: 1 / -1; }
  }

  @media (max-width: 700px) {
    .local-badge { display: none; }
    .editor-header,
    .editor-footer {
      align-items: stretch;
      flex-direction: column;
    }
    .editor-header { gap: 0.5rem; }
    .save-state { align-self: flex-start; }
    .note-counts { justify-content: space-between; }
    .editor-actions { display: grid; grid-template-columns: 1fr 1fr; }
    .editor-actions .clear-button { grid-column: 1 / -1; }
    .scratchpad-sidebar { grid-template-columns: 1fr; }
    .shortcut-note { grid-column: auto; }
    #scratchpad-editor { min-height: 30rem; }
  }
</style>
