---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperimentCard from '../components/ExperimentCard.astro';

const experiments = [
  {
    href: '/sales/interview/',
    number: '01',
    title: 'Interview drill',
    description: 'A no-repeat question deck for practicing concise, evidence-rich sales interview answers.',
    category: 'Sales practice',
    status: 'Shipped' as const,
    technologies: ['Astro', 'TypeScript', 'localStorage'],
    learning: 'A shuffle bag creates better practice variety than a fresh random draw.',
    next: 'Add custom question import and session-level review notes.',
    accent: 'green' as const,
  },
  {
    href: '/tools/scratchpad/',
    number: '02',
    title: 'Local scratchpad',
    description: 'Private, auto-saving daily pages with date navigation and one chronological Markdown dump.',
    category: 'Utility',
    status: 'Shipped' as const,
    technologies: ['Astro', 'Browser storage', 'Blob API'],
    learning: 'A useful daily-writing system can stay private, persistent, portable, and account-free.',
    next: 'Add optional import after the Markdown dump format proves stable.',
    accent: 'orange' as const,
  },
  {
    href: '/learning/',
    number: '03',
    title: 'Learning cards',
    description: 'A rotating set of ideas worth keeping, shuffled so familiar cards cannot always lead.',
    category: 'Learning system',
    status: 'Shipped' as const,
    technologies: ['Astro', 'TypeScript', 'Shuffle bag'],
    learning: 'Persistent randomization makes repeat visits feel varied without losing deck coverage.',
    next: 'Generate cards from selected Markdown notes.',
    accent: 'blue' as const,
  },
  {
    href: '/reading/',
    number: '04',
    title: 'Reading explorer',
    description: 'A searchable reading log that turns a small JSON file into an explorable knowledge shelf.',
    category: 'Data-driven page',
    status: 'Prototype' as const,
    technologies: ['Astro', 'JSON', 'Client filters'],
    learning: 'Structured source data can support several views without adding a database.',
    next: 'Replace starter entries with the real reading catalog and notes.',
    accent: 'orange' as const,
  },
  {
    href: '/sales/meddpicc/',
    number: '05',
    title: 'MEDDPICC scorecard',
    description: 'An evidence-first deal review that exposes qualification gaps and creates a copyable summary.',
    category: 'Sales operating tool',
    status: 'Prototype' as const,
    technologies: ['Astro', 'TypeScript', 'localStorage'],
    learning: 'Scoring becomes useful when every selection must be supported by evidence.',
    next: 'Add named local deals and compare score changes over time.',
    accent: 'green' as const,
  },
  {
    href: '/sales/pov-builder/',
    number: '06',
    title: 'Account POV builder',
    description: 'A structured workspace for turning account signals into a testable value hypothesis.',
    category: 'Sales research tool',
    status: 'Prototype' as const,
    technologies: ['Astro', 'JSON schema', 'Markdown export'],
    learning: 'A point of view is strongest when evidence, assumptions, and discovery questions stay distinct.',
    next: 'Add optional public-signal imports once the manual workflow is proven.',
    accent: 'blue' as const,
  },
];
---

<BaseLayout
  title="Russ Vaccaro Lab — Small browser experiments"
  description="Small browser experiments for sales practice, technical learning, and clearer thinking."
>
  <section class="hero shell">
    <div class="hero-grid">
      <div>
        <p class="eyebrow">Personal software, in public</p>
        <h1>Tools for <em>sharper</em> work.</h1>
      </div>
      <div class="hero-side">
        <p>
          A working notebook for small ideas: useful enough to keep, contained enough to ship quickly.
        </p>
        <div class="hero-meta" aria-label="Project principles">
          <span>Static Astro</span>
          <span>Browser first</span>
          <span>No accounts</span>
        </div>
        <a class="main-home-link" href="https://russvaccaro.com">Visit russvaccaro.com <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="projects-section shell" aria-labelledby="projects-title">
    <div class="section-heading">
      <div>
        <p class="kicker">Current experiments</p>
        <h2 id="projects-title">Six useful, inspectable loops.</h2>
      </div>
      <p>Each card records what the experiment does, what it taught, and the next meaningful improvement.</p>
    </div>

    <div class="experiment-grid">
      {experiments.map((experiment) => <ExperimentCard {...experiment} />)}
    </div>
  </section>

  <section class="principles shell" aria-labelledby="principles-title">
    <div class="principles-copy">
      <p class="kicker">Build sequence</p>
      <h2 id="principles-title">Complexity has to earn its place.</h2>
      <p>The lab progresses from static pages to structured data, interaction, persistence, and APIs only when the experiment needs the next layer.</p>
    </div>
    <ol class="principles-list">
      <li>
        <span>01</span>
        <div><h3>Static and legible</h3><p>Make the purpose, content, and information architecture work before adding state.</p></div>
      </li>
      <li>
        <span>02</span>
        <div><h3>Data-driven and interactive</h3><p>Move repeated content into structured files, then add only the interactions that improve its use.</p></div>
      </li>
      <li>
        <span>03</span>
        <div><h3>Persistent when proven</h3><p>Start with device-local state. Add accounts or external APIs only after the workflow earns them.</p></div>
      </li>
    </ol>
  </section>
</BaseLayout>

<style>
  .experiment-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .main-home-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.25rem;
    color: var(--text);
    font-size: 0.78rem;
    font-weight: 720;
    text-decoration: none;
  }

  .main-home-link:hover { color: var(--green); }

  @media (max-width: 760px) {
    .experiment-grid { grid-template-columns: 1fr; }
  }
</style>
