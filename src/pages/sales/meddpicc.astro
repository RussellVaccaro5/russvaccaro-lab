---
import PageHeader from '../../components/PageHeader.astro';
import LabLayout from '../../layouts/LabLayout.astro';
import { meddpiccDimensions } from '../../data/meddpicc';
---

<LabLayout
  title="MEDDPICC Deal Diagnostic"
  description="A browser-only MEDDPICC evidence diagnostic that highlights qualification gaps."
>
  <PageHeader
    eyebrow="Deal qualification"
    title="MEDDPICC deal diagnostic"
    description="Rate the quality of evidence behind each dimension. The score is a prompt for inspection—not a forecast and not a substitute for manager judgment."
  />

  <div class="notice">
    This prototype saves entries only in this browser. Use a fictional or sanitized opportunity; do
    not enter customer-confidential information.
  </div>

  <section class="score-summary" aria-live="polite">
    <div>
      <p class="eyebrow">Evidence score</p>
      <p class="score"><span id="score-total">0</span><small>/24</small></p>
    </div>
    <div class="score-summary__assessment">
      <p id="score-label"><strong>Not yet assessed</strong></p>
      <progress id="score-progress" max="24" value="0">0 of 24</progress>
      <p id="score-guidance" class="muted">Rate each area from assumption to validated evidence.</p>
    </div>
  </section>

  <form id="meddpicc-form">
    <div class="dimension-grid">
      {
        meddpiccDimensions.map((dimension, index) => (
          <section class="dimension-card" data-key={dimension.key}>
            <div class="dimension-card__number">{String(index + 1).padStart(2, '0')}</div>
            <div>
              <h2>{dimension.label}</h2>
              <p>{dimension.prompt}</p>
              <p class="evidence"><strong>Strong evidence:</strong> {dimension.evidence}</p>
            </div>
            <div class="field">
              <label for={`${dimension.key}-score`}>Evidence quality</label>
              <select id={`${dimension.key}-score`} class="dimension-score" name={`${dimension.key}-score`}>
                <option value="0">0 — Not assessed</option>
                <option value="1">1 — Assumption or weak signal</option>
                <option value="2">2 — Partially validated</option>
                <option value="3">3 — Validated with evidence</option>
              </select>
            </div>
            <div class="field notes-field">
              <label for={`${dimension.key}-notes`}>Evidence and next question</label>
              <textarea
                id={`${dimension.key}-notes`}
                class="dimension-notes"
                name={`${dimension.key}-notes`}
                placeholder="What do you know? What still needs validation?"
              ></textarea>
            </div>
          </section>
        ))
      }
    </div>

    <section class="risk-summary card">
      <h2>Weakest qualification areas</h2>
      <p class="muted">Dimensions scored 0 or 1 appear here.</p>
      <ul id="risk-list">
        {meddpiccDimensions.map((dimension) => <li data-risk-key={dimension.key}>{dimension.label}</li>)}
      </ul>
    </section>

    <div class="button-row form-actions">
      <span id="save-state" class="muted" aria-live="polite">Changes save in this browser.</span>
      <button id="clear-scorecard" class="button danger" type="button">Clear scorecard</button>
    </div>
  </form>
</LabLayout>

<script>
  const storageKey = 'rv-lab-meddpicc-v1';
  const form = document.querySelector<HTMLFormElement>('#meddpicc-form');
  const cards = [...document.querySelectorAll<HTMLElement>('.dimension-card')];
  const totalElement = document.querySelector<HTMLElement>('#score-total');
  const labelElement = document.querySelector<HTMLElement>('#score-label');
  const guidanceElement = document.querySelector<HTMLElement>('#score-guidance');
  const progressElement = document.querySelector<HTMLProgressElement>('#score-progress');
  const saveState = document.querySelector<HTMLElement>('#save-state');
  const clearButton = document.querySelector<HTMLButtonElement>('#clear-scorecard');

  interface DimensionState {
    score: string;
    notes: string;
  }

  type StoredScorecard = Record<string, DimensionState>;

  const assessment = (score: number) => {
    if (score >= 20) {
      return {
        label: 'Strong evidence base',
        guidance: 'Pressure-test the remaining gaps and confirm that evidence is current.',
      };
    }
    if (score >= 14) {
      return {
        label: 'Working qualification with exposure',
        guidance: 'Focus the next customer interaction on the lowest-scoring dimensions.',
      };
    }
    if (score >= 8) {
      return {
        label: 'Early or incomplete qualification',
        guidance: 'Several critical parts of the buying process still depend on assumptions.',
      };
    }
    if (score > 0) {
      return {
        label: 'Weak evidence',
        guidance: 'Re-open discovery before treating timing or close probability as reliable.',
      };
    }
    return {
      label: 'Not yet assessed',
      guidance: 'Rate each area from assumption to validated evidence.',
    };
  };

  const readState = (): StoredScorecard => {
    const state: StoredScorecard = {};

    cards.forEach((card) => {
      const key = card.dataset.key;
      const score = card.querySelector<HTMLSelectElement>('.dimension-score');
      const notes = card.querySelector<HTMLTextAreaElement>('.dimension-notes');

      if (key && score && notes) {
        state[key] = { score: score.value, notes: notes.value };
      }
    });

    return state;
  };

  const renderScore = () => {
    let total = 0;

    cards.forEach((card) => {
      const key = card.dataset.key;
      const select = card.querySelector<HTMLSelectElement>('.dimension-score');
      const score = Number(select?.value ?? 0);
      total += score;
      card.classList.toggle('risk', score <= 1);

      if (key) {
        const riskItem = document.querySelector<HTMLElement>(`[data-risk-key="${key}"]`);
        if (riskItem) riskItem.hidden = score > 1;
      }
    });

    const result = assessment(total);
    if (totalElement) totalElement.textContent = String(total);
    if (labelElement) labelElement.innerHTML = `<strong>${result.label}</strong>`;
    if (guidanceElement) guidanceElement.textContent = result.guidance;
    if (progressElement) progressElement.value = total;
  };

  const save = () => {
    localStorage.setItem(storageKey, JSON.stringify(readState()));
    if (saveState) {
      saveState.textContent = 'Saved in this browser.';
      window.setTimeout(() => {
        saveState.textContent = 'Changes save in this browser.';
      }, 1200);
    }
  };

  const restore = () => {
    const raw = localStorage.getItem(storageKey);
    if (!raw) return;

    try {
      const state = JSON.parse(raw) as StoredScorecard;
      cards.forEach((card) => {
        const key = card.dataset.key;
        if (!key || !state[key]) return;

        const select = card.querySelector<HTMLSelectElement>('.dimension-score');
        const notes = card.querySelector<HTMLTextAreaElement>('.dimension-notes');
        if (select) select.value = state[key].score;
        if (notes) notes.value = state[key].notes;
      });
    } catch {
      localStorage.removeItem(storageKey);
    }
  };

  form?.addEventListener('input', () => {
    renderScore();
    save();
  });

  clearButton?.addEventListener('click', () => {
    if (!window.confirm('Clear every score and note saved in this browser?')) return;
    form?.reset();
    localStorage.removeItem(storageKey);
    renderScore();
  });

  restore();
  renderScore();
</script>

<style>
  .score-summary {
    display: grid;
    margin: 28px 0;
    padding: 24px;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 28px;
    align-items: center;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .score {
    margin: 0;
    font-size: 3.4rem;
    font-weight: 850;
    line-height: 1;
  }

  .score small {
    color: var(--muted);
    font-size: 1rem;
  }

  .score-summary__assessment p {
    margin-bottom: 8px;
  }

  progress {
    width: 100%;
    height: 12px;
    accent-color: var(--accent);
  }

  .dimension-grid {
    display: grid;
    gap: 16px;
  }

  .dimension-card {
    display: grid;
    padding: 24px;
    grid-template-columns: 50px minmax(230px, 1.2fr) minmax(210px, 0.8fr) minmax(260px, 1fr);
    gap: 20px;
    align-items: start;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .dimension-card.risk {
    border-left: 4px solid var(--warning);
  }

  .dimension-card__number {
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 800;
  }

  .dimension-card h2 {
    margin-bottom: 8px;
    font-size: 1.22rem;
  }

  .dimension-card p {
    margin-bottom: 8px;
  }

  .evidence {
    color: var(--muted);
    font-size: 0.88rem;
  }

  .notes-field textarea {
    min-height: 126px;
  }

  .risk-summary {
    margin-top: 24px;
  }

  .risk-summary ul {
    display: flex;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
  }

  .risk-summary li {
    padding: 5px 10px;
    border-radius: 999px;
    color: var(--warning);
    background: var(--warning-soft);
    font-size: 0.82rem;
    font-weight: 750;
  }

  .form-actions {
    margin-top: 20px;
    align-items: center;
    justify-content: space-between;
  }

  @media (max-width: 1050px) {
    .dimension-card {
      grid-template-columns: 40px minmax(0, 1fr) minmax(220px, 0.8fr);
    }

    .notes-field {
      grid-column: 2 / -1;
    }
  }

  @media (max-width: 700px) {
    .score-summary,
    .dimension-card {
      grid-template-columns: 1fr;
    }

    .notes-field {
      grid-column: auto;
    }

    .form-actions {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>
