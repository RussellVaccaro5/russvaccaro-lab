---
import PageHeader from '../../components/PageHeader.astro';
import LabLayout from '../../layouts/LabLayout.astro';
---

<LabLayout
  title="Target Account POV Builder"
  description="A deterministic account POV template that converts research signals into a testable sales hypothesis."
>
  <PageHeader
    eyebrow="Account research"
    title="Target account POV builder"
    description="Turn public signals into a concise working hypothesis you can test through outreach and discovery. The first version uses a transparent template rather than AI."
  />

  <div class="notice">
    Use public, fictional, or sanitized information. Drafts persist only in this browser until you
    clear them.
  </div>

  <div class="builder-layout">
    <form id="pov-form" class="builder-form card">
      <div class="field">
        <label for="company">Company</label>
        <input id="company" name="company" placeholder="Example Corp" />
      </div>

      <div class="field">
        <label for="trigger">Trigger event or observable signal</label>
        <textarea
          id="trigger"
          name="trigger"
          placeholder="New product launch, funding, cloud migration, leadership hire, outage, acquisition…"
        ></textarea>
      </div>

      <div class="field">
        <label for="initiative">Likely strategic initiative</label>
        <textarea
          id="initiative"
          name="initiative"
          placeholder="What business or technical objective might the signal support?"
        ></textarea>
      </div>

      <div class="field">
        <label for="environment">Current environment or operating context</label>
        <textarea
          id="environment"
          name="environment"
          placeholder="Known architecture, team model, tools, market pressure, or constraints."
        ></textarea>
      </div>

      <div class="field">
        <label for="problem">Likely problem or friction</label>
        <textarea
          id="problem"
          name="problem"
          placeholder="What obstacle could make the initiative harder, slower, riskier, or more expensive?"
        ></textarea>
      </div>

      <div class="field">
        <label for="impact">Potential business impact</label>
        <textarea
          id="impact"
          name="impact"
          placeholder="Revenue, cost, risk, speed, customer experience, developer productivity…"
        ></textarea>
      </div>

      <div class="field">
        <label for="capability">Relevant capability</label>
        <textarea
          id="capability"
          name="capability"
          placeholder="Describe the capability in customer language, not a product feature dump."
        ></textarea>
      </div>

      <div class="field">
        <label for="proof">Credibility or proof point</label>
        <textarea
          id="proof"
          name="proof"
          placeholder="Customer outcome, technical proof, benchmark, or relevant experience."
        ></textarea>
      </div>

      <div class="field">
        <label for="questions">Discovery questions, one per line</label>
        <textarea
          id="questions"
          name="questions"
          placeholder="How are you currently…?&#10;What changes if…?&#10;Who feels the impact when…?"
        ></textarea>
      </div>
    </form>

    <aside class="output-panel">
      <div class="output-panel__header">
        <div>
          <p class="eyebrow">Generated output</p>
          <h2>Working account POV</h2>
        </div>
        <span id="draft-state" class="muted" aria-live="polite">Draft saves locally.</span>
      </div>
      <pre id="pov-output" tabindex="0"></pre>
      <div class="button-row">
        <button id="copy-pov" class="button" type="button">Copy POV</button>
        <button id="download-pov" class="button secondary" type="button">Download .txt</button>
        <button id="clear-pov" class="button danger" type="button">Clear</button>
      </div>
    </aside>
  </div>
</LabLayout>

<script>
  const storageKey = 'rv-lab-account-pov-v1';
  const form = document.querySelector<HTMLFormElement>('#pov-form');
  const output = document.querySelector<HTMLElement>('#pov-output');
  const copyButton = document.querySelector<HTMLButtonElement>('#copy-pov');
  const downloadButton = document.querySelector<HTMLButtonElement>('#download-pov');
  const clearButton = document.querySelector<HTMLButtonElement>('#clear-pov');
  const draftState = document.querySelector<HTMLElement>('#draft-state');

  const fieldNames = [
    'company',
    'trigger',
    'initiative',
    'environment',
    'problem',
    'impact',
    'capability',
    'proof',
    'questions',
  ] as const;

  type FieldName = (typeof fieldNames)[number];
  type PovDraft = Record<FieldName, string>;

  const emptyDraft = (): PovDraft => ({
    company: '',
    trigger: '',
    initiative: '',
    environment: '',
    problem: '',
    impact: '',
    capability: '',
    proof: '',
    questions: '',
  });

  const getField = (name: FieldName) =>
    form?.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | null;

  const readDraft = (): PovDraft => {
    const draft = emptyDraft();
    fieldNames.forEach((name) => {
      draft[name] = getField(name)?.value.trim() ?? '';
    });
    return draft;
  };

  const placeholder = (value: string, fallback: string) => value || `[${fallback}]`;

  const buildOutput = (draft: PovDraft) => {
    const questions = draft.questions
      .split('\n')
      .map((question) => question.trim())
      .filter(Boolean)
      .map((question) => `- ${question}`)
      .join('\n');

    return `ACCOUNT POV — ${placeholder(draft.company, 'Company')}

OBSERVED SIGNAL
${placeholder(draft.trigger, 'Public trigger event or observable signal')}

WORKING HYPOTHESIS
${placeholder(draft.company, 'The company')} may be prioritizing ${placeholder(draft.initiative, 'a strategic initiative')}. In the context of ${placeholder(draft.environment, 'its current environment')}, the team may be experiencing ${placeholder(draft.problem, 'a consequential problem')}, which could affect ${placeholder(draft.impact, 'a measurable business outcome')}.

WHY THIS MAY BE RELEVANT
${placeholder(draft.capability, 'Relevant capability stated in customer language')}

CREDIBILITY
${placeholder(draft.proof, 'Relevant proof point or customer outcome')}

QUESTIONS TO TEST THE HYPOTHESIS
${questions || '- [Add discovery questions, one per line]'}

CONFIDENCE CHECK
This is a research-based hypothesis. Validate the problem, impact, priority, and buying context with the customer.`;
  };

  const render = () => {
    const draft = readDraft();
    if (output) output.textContent = buildOutput(draft);
    localStorage.setItem(storageKey, JSON.stringify(draft));

    if (draftState) {
      draftState.textContent = 'Saved in this browser.';
      window.setTimeout(() => {
        draftState.textContent = 'Draft saves locally.';
      }, 1000);
    }
  };

  const restore = () => {
    const raw = localStorage.getItem(storageKey);
    if (!raw) return;

    try {
      const draft = JSON.parse(raw) as Partial<PovDraft>;
      fieldNames.forEach((name) => {
        const field = getField(name);
        if (field) field.value = draft[name] ?? '';
      });
    } catch {
      localStorage.removeItem(storageKey);
    }
  };

  form?.addEventListener('input', render);

  copyButton?.addEventListener('click', async () => {
    const text = output?.textContent ?? '';
    await navigator.clipboard.writeText(text);
    copyButton.textContent = 'Copied';
    window.setTimeout(() => {
      copyButton.textContent = 'Copy POV';
    }, 1200);
  });

  downloadButton?.addEventListener('click', () => {
    const draft = readDraft();
    const text = output?.textContent ?? '';
    const safeCompany = (draft.company || 'account-pov').toLowerCase().replace(/[^a-z0-9]+/g, '-');
    const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = `${safeCompany}-pov.txt`;
    link.click();
    URL.revokeObjectURL(url);
  });

  clearButton?.addEventListener('click', () => {
    if (!window.confirm('Clear this draft from the page and browser storage?')) return;
    form?.reset();
    localStorage.removeItem(storageKey);
    render();
    getField('company')?.focus();
  });

  restore();
  render();
</script>

<style>
  .builder-layout {
    display: grid;
    margin-top: 28px;
    grid-template-columns: minmax(0, 1fr) minmax(360px, 0.9fr);
    gap: 20px;
    align-items: start;
  }

  .builder-form {
    display: grid;
    gap: 18px;
  }

  .output-panel {
    position: sticky;
    top: 88px;
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .output-panel__header {
    display: flex;
    margin-bottom: 14px;
    justify-content: space-between;
    gap: 20px;
  }

  .output-panel__header h2 {
    margin-bottom: 0;
  }

  #pov-output {
    max-height: 62vh;
    margin: 0 0 16px;
    padding: 18px;
    overflow: auto;
    border: 1px solid var(--border);
    border-radius: 12px;
    color: var(--text);
    background: var(--background);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.84rem;
    line-height: 1.55;
    white-space: pre-wrap;
  }

  @media (max-width: 920px) {
    .builder-layout {
      grid-template-columns: 1fr;
    }

    .output-panel {
      position: static;
    }
  }
</style>
