---
import PageHeader from '../components/PageHeader.astro';
import LabLayout from '../layouts/LabLayout.astro';
import books from '../data/books.json';

const categories = [...new Set(books.map((book) => book.category))].sort();
const statuses = [...new Set(books.map((book) => book.status))].sort();
---

<LabLayout
  title="Reading Log"
  description="A searchable public reading log with status, category, rating, and concise takeaways."
>
  <PageHeader
    eyebrow="Reading system"
    title="Reading log explorer"
    description="A lightweight record of what earned your attention and the specific idea worth retaining."
  />

  <div class="notice">
    The included entries are placeholders. Replace them in <code>src/data/books.json</code> before
    publishing this page as your reading history.
  </div>

  <div class="controls">
    <div class="field">
      <label for="book-search">Search</label>
      <input id="book-search" type="search" placeholder="Title, author, category, takeaway…" />
    </div>
    <div class="field">
      <label for="book-category">Category</label>
      <select id="book-category">
        <option value="all">All categories</option>
        {categories.map((category) => <option value={category}>{category}</option>)}
      </select>
    </div>
    <div class="field">
      <label for="book-status">Status</label>
      <select id="book-status">
        <option value="all">All statuses</option>
        {statuses.map((status) => <option value={status}>{status}</option>)}
      </select>
    </div>
    <div class="button-stack">
      <button id="random-book" class="button secondary" type="button">Random book</button>
      <button id="reset-books" class="button secondary" type="button">Reset</button>
    </div>
  </div>

  <p id="book-count" class="muted" aria-live="polite">{books.length} books</p>

  <div id="book-grid" class="book-grid">
    {
      books.map((book) => (
        <article
          class="book-card"
          data-search={`${book.title} ${book.author} ${book.category} ${book.status} ${book.takeaway}`.toLowerCase()}
          data-category={book.category}
          data-status={book.status}
        >
          <div class="book-card__meta">
            <span>{book.category}</span>
            <span>{book.status}</span>
          </div>
          <h2>{book.title}</h2>
          <p class="muted">{book.author}</p>
          <p><strong>Takeaway:</strong> {book.takeaway}</p>
          <div class="book-card__footer">
            <span>
              {book.rating ? `${'★'.repeat(book.rating)}${'☆'.repeat(5 - book.rating)}` : 'Not rated'}
            </span>
            {book.noteUrl && <a href={book.noteUrl}>Open note →</a>}
          </div>
        </article>
      ))
    }
  </div>

  <p id="no-books" class="notice" hidden>No books match those filters.</p>
</LabLayout>

<script>
  const search = document.querySelector<HTMLInputElement>('#book-search');
  const category = document.querySelector<HTMLSelectElement>('#book-category');
  const status = document.querySelector<HTMLSelectElement>('#book-status');
  const randomButton = document.querySelector<HTMLButtonElement>('#random-book');
  const resetButton = document.querySelector<HTMLButtonElement>('#reset-books');
  const count = document.querySelector<HTMLElement>('#book-count');
  const noResults = document.querySelector<HTMLElement>('#no-books');
  const cards = [...document.querySelectorAll<HTMLElement>('.book-card')];

  const getVisibleCards = () => cards.filter((card) => !card.hidden);

  const filterBooks = () => {
    const query = search?.value.trim().toLowerCase() ?? '';
    const selectedCategory = category?.value ?? 'all';
    const selectedStatus = status?.value ?? 'all';
    let visible = 0;

    cards.forEach((card) => {
      const matchesSearch = card.dataset.search?.includes(query) ?? false;
      const matchesCategory = selectedCategory === 'all' || card.dataset.category === selectedCategory;
      const matchesStatus = selectedStatus === 'all' || card.dataset.status === selectedStatus;
      const shouldShow = matchesSearch && matchesCategory && matchesStatus;
      card.hidden = !shouldShow;
      card.classList.remove('selected');
      if (shouldShow) visible += 1;
    });

    if (count) count.textContent = `${visible} ${visible === 1 ? 'book' : 'books'}`;
    if (noResults) noResults.hidden = visible !== 0;
  };

  search?.addEventListener('input', filterBooks);
  category?.addEventListener('change', filterBooks);
  status?.addEventListener('change', filterBooks);

  resetButton?.addEventListener('click', () => {
    if (search) search.value = '';
    if (category) category.value = 'all';
    if (status) status.value = 'all';
    filterBooks();
    search?.focus();
  });

  randomButton?.addEventListener('click', () => {
    const visibleCards = getVisibleCards();
    cards.forEach((card) => card.classList.remove('selected'));
    if (!visibleCards.length) return;

    const selectedCard = visibleCards[Math.floor(Math.random() * visibleCards.length)];
    selectedCard.classList.add('selected');
    selectedCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });
</script>

<style>
  .button-stack {
    display: flex;
    padding-top: 25px;
    gap: 8px;
  }

  .book-grid {
    display: grid;
    margin-top: 18px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .book-card {
    display: flex;
    min-height: 285px;
    padding: 24px;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    transition:
      border-color 160ms ease,
      transform 160ms ease;
  }

  .book-card.selected {
    transform: translateY(-3px);
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .book-card__meta,
  .book-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .book-card h2 {
    margin: 20px 0 5px;
  }

  .book-card__footer {
    margin-top: auto;
    padding-top: 18px;
    border-top: 1px solid var(--border);
  }

  @media (max-width: 900px) {
    .button-stack {
      padding-top: 0;
      align-self: end;
    }
  }

  @media (max-width: 680px) {
    .book-grid {
      grid-template-columns: 1fr;
    }

    .button-stack {
      align-self: stretch;
    }

    .button-stack .button {
      flex: 1;
    }
  }
</style>
