---
import PageHeader from '../components/PageHeader.astro';
import LabLayout from '../layouts/LabLayout.astro';
import { changelog } from '../data/changelog';
---

<LabLayout title="Changelog" description="A public record of changes and lessons from the lab.">
  <PageHeader
    eyebrow="Ship log"
    title="Changelog"
    description="A short record of what shipped, why it changed, and what the iteration taught."
  />

  <div class="notice">
    Update <code>src/data/changelog.ts</code> after each merge. One useful sentence about what you
    learned matters more than a long feature inventory.
  </div>

  <ol class="timeline">
    {
      changelog.map((entry) => (
        <li class="timeline__entry">
          <div class="timeline__meta">
            <time datetime={entry.date}>{entry.date}</time>
            <span>v{entry.version}</span>
          </div>
          <div class="card">
            <h2>{entry.title}</h2>
            <ul>
              {entry.changes.map((change) => <li>{change}</li>)}
            </ul>
            <p><strong>Learned:</strong> {entry.learned}</p>
          </div>
        </li>
      ))
    }
  </ol>
</LabLayout>

<style>
  .timeline {
    margin: 44px 0 0;
    padding: 0;
    list-style: none;
  }

  .timeline__entry {
    display: grid;
    margin-bottom: 24px;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: 20px;
  }

  .timeline__meta {
    display: flex;
    padding-top: 20px;
    flex-direction: column;
    color: var(--muted);
    font-size: 0.88rem;
    font-weight: 700;
  }

  .card ul {
    padding-left: 22px;
  }

  @media (max-width: 620px) {
    .timeline__entry {
      grid-template-columns: 1fr;
      gap: 4px;
    }

    .timeline__meta {
      padding-top: 0;
      flex-direction: row;
      gap: 10px;
    }
  }
</style>
